library identifier: 'jenkins-shared-library@main', retriever: modernSCM([
    $class: 'GitSCMSource',
    remote: 'http://192.168.15.85/devsecops1/pipeline.git',
    credentialsId: 'lsaid',
    traits: [[$class: 'jenkins.plugins.git.traits.BranchDiscoveryTrait']]
])

pipeline {
    agent any

    environment {
        // Project Identity
        PROJECT_NAME   = 'Credit Score ML Engine'
        IMAGE_NAME     = 'credit-score-ml-engine'
        HARBOR_PROJECT = 'softcms'

        // On-Prem Registry Config
        REGISTRY_URL            = 'harbor.devops.softnethq.co.tz'
        REGISTRY_CREDENTIALS_ID = 'robot-jenkins'

        // Team Notifications
        NOTIFICATION_EMAIL = 'dfaustine@softnet.co.tz,lsaid@softnet.co.tz'

        // Source Code Info
        BRANCH_NAME        = 'main'
        GIT_REPO_URL       = 'http://192.168.15.85/softcms-v2/credit-score-ml-engine.git'
        GIT_CREDENTIALS_ID = 'lsaid'

        // K8s Manifest Config (GitOps)
        K8S_MANIFEST_REPO_URL       = 'http://192.168.15.85/kubernetes-manifest/softcms/credit-score-ml-engine.git'
        K8S_MANIFEST_CREDENTIALS_ID = 'lsaid'
        K8S_MANIFEST_BRANCH         = 'main'
        K8S_MANIFEST_PATHS          = '04-deployment.yaml'

        // Build Info
        BUILD_TOOL   = 'python'
        APP_TIMEZONE = 'Africa/Dar_es_Salaam'

        // Traceability (set AFTER checkout)
        APP_VERSION = "1.0.${env.BUILD_NUMBER}"
    }

    stages {

        stage('Checkout and Git Info') {
            steps {
                script {
                    checkoutAndGitInfo()

                    env.GIT_COMMIT   = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
                    env.GIT_AUTHOR   = sh(script: 'git log -1 --pretty=format:"%an"', returnStdout: true).trim()
                    env.BUILD_DATE_UTC = sh(script: "date -u +'%Y-%m-%dT%H:%M:%SZ'", returnStdout: true).trim()
                }
            }
        }

        stage('Send Start Notification') {
            steps {
                script {
                    sendStartNotification(
                        subject: "🚀 Pipeline Started: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                        recipients: env.NOTIFICATION_EMAIL,
                        triggeredBy: detectBuildTrigger()
                    )
                }
            }
        }

        // stage('Vulnerability Scan - Docker') {
        //     steps {
        //         script {
        //             vulnScanDocker()
        //         }
        //     }
        // }

        stage('Build Docker Image and Publish') {
            steps {
                script {
                    def result = buildDockerImageAndPush(
                        imageName: env.IMAGE_NAME,
                        imageTag: env.BUILD_NUMBER,
                        harborProject: env.HARBOR_PROJECT,
                        registryUrl: env.REGISTRY_URL,
                        registryCredentialsId: env.REGISTRY_CREDENTIALS_ID,
                        dockerfilePath: './airflow/Dockerfile',
                        buildContext: '.',
                        pushToRegistry: true,
                        buildArgs: [
                            VERSION: env.APP_VERSION,
                            GIT_COMMIT: env.GIT_COMMIT,
                            GIT_AUTHOR: env.GIT_AUTHOR,
                            BUILD_DATE: env.BUILD_DATE_UTC,
                            APP_TIMEZONE: env.APP_TIMEZONE
                        ]
                    )
                    env.FINAL_IMAGE_NAME = result.localImageName
                }
            }
        }

        stage('k8s Manifest Cloning & Update') {
            steps {
                script {
                    k8sManifestScanAndUpdate()
                }
            }
        }
    }

    post {

        success {
            script {
                sendSuccessNotification(
                    recipients: env.NOTIFICATION_EMAIL,
                    triggeredBy: detectBuildTrigger()
                )
            }
        }

        failure {
            script {
                echo """
                PIPELINE FAILED
                JOB: ${env.JOB_NAME}
                BUILD: #${env.BUILD_NUMBER}
                COMMIT: ${env.GIT_COMMIT}
                AUTHOR: ${env.GIT_AUTHOR}
                IMAGE: ${env.FINAL_IMAGE_NAME}
                """

                sendFailureNotification(
                    recipients: env.NOTIFICATION_EMAIL,
                    triggeredBy: detectBuildTrigger()
                )
            }
        }
    }
}
